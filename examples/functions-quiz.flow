flow get_question
    if @input is exactly 1
        set question = {"prompt": "How many minutes are in an hour? a) 30 b) 60 c) 90", "answer": "b"}
    else
        if @input is exactly 2
            set question = {"prompt": "Which number is even? a) 7 b) 9 c) 12", "answer": "c"}
        else
            set question = {"prompt": "How many sides does a triangle have? a) 3 b) 4 c) 5", "answer": "a"}
    set result = @question

flow score_answer
    if @input.given is exactly @input.expected
        set points = 1
    else
        set points = 0
    set result = @points

command ASK_QUESTION
    print @input.prompt
    ask "Your answer? Enter a, b, or c." as @answer
    while @answer is not exactly one of "a", "b", or "c"
        ask "Please enter exactly a, b, or c in lowercase." as @answer

    do Return an object with fields given from @answer and expected from @input.answer as @response
    score_answer @response as @points

    if @points is exactly 1
        print "Correct!"
    else
        print "The correct answer is:" @input.answer
    set result = @points

print "Quick quiz: three questions, one point for each correct answer."
set score = 0
set question_number = 1

repeat 3 times
    print "Question" @question_number "of 3"
    get_question @question_number as @question
    ASK_QUESTION @question as @points
    set score = @score + @points
    set question_number = @question_number + 1

print "Final score:" @score "out of 3"
if @score is exactly 3
    print "Perfect score!"
else
    if @score is greater than 0
        print "Good effort. Try again to improve your score."
    else
        print "Keep practising. You can try the quiz again."
