COMMAND GREET
    IF @input is exactly "Ana"
        DO Return the exact string "Welcome back, Ana." AS greeting
    ELSE
        DO Write a short greeting for @input. AS greeting
    DO Return @greeting unchanged.

ASK "What is your name?" AS name
WHILE @name is an empty string
    ASK "Please enter a name." AS name
GREET @name AS greeting
PRINT @greeting
