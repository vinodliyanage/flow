# Interactive feature launch planner

PRINT "Let us create a launch plan."

ASK "What feature or product are you planning to launch?" AS feature
IF @feature == ""
    RETURN "A feature or product name is required."

ASK "Who is the main audience? Leave this empty to use general users." AS audience
IF @audience == ""
    SET audience = "General users"
ELSE
    PRINT "The audience has been recorded."

ASK "Choose the launch pace. Type exactly urgent or normal." AS pace
IF @pace != "urgent" AND @pace != "normal"
    RETURN "The launch pace must be urgent or normal."

DO Define a focused launch scope for @feature and @audience.
    Return an object with summary, included, and excluded fields. AS scope

PRINT @scope

IF @pace == "urgent"
    DO Create an accelerated launch schedule from @scope.
        Return an object with phases, deadlines, and warnings fields. AS schedule
ELSE
    DO Create a standard launch schedule from @scope.
        Return an object with phases, deadlines, and warnings fields. AS schedule

ASK "Should the plan include a risk review? Type exactly yes or no." AS risk_choice
IF @risk_choice != "yes" AND @risk_choice != "no"
    RETURN "The risk-review answer must be yes or no."

IF @risk_choice == "yes"
    DO Assess the launch risks using @scope and @schedule.
        Return an object with status, risks, and mitigations fields. AS risk_review
ELSE
    SET risk_review = {"status": "skipped", "risks": [], "mitigations": []}

DO Create a concise launch brief using @feature, @audience, @scope,
    @schedule, and @risk_review. Return an object with overview,
    action_items, and recommendation fields. AS launch_brief

PRINT @launch_brief

ASK "Do you approve this launch brief? Type exactly yes or no." AS approval
IF @approval != "yes" AND @approval != "no"
    RETURN "The approval answer must be yes or no."

IF @approval == "yes"
    DO Convert @launch_brief into an ordered launch checklist.
        Return an array of short checklist items. AS next_steps
    PRINT @next_steps
    RETURN "The launch plan is approved."
ELSE
    DO Identify three specific questions that would improve @launch_brief.
        Return an array of questions. AS revision_questions
    PRINT @revision_questions
    RETURN "The launch plan needs revision."
