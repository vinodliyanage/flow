flow add_one
    return @input + 1

command ADD_TWO
    add_one @input as @first
    add_one @first as @second
    return @second

flow add_three
    ADD_TWO @input as @first
    add_one @first as @second
    return @second

add_one 4 as @next
print @next

ADD_TWO @next as @total
print @total

add_three @total as @final_total
print @final_total
