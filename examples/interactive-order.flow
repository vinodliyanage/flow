# A small interactive test for strict execution order.

PRINT "ORDER 1: The flow started."

ASK "ORDER 2: What is your name?" AS name

PRINT "ORDER 3: The first answer was received. Your name is:"
PRINT @name

ASK "ORDER 4: Choose tea or coffee. Type exactly: tea or coffee" AS drink

PRINT "ORDER 5: The drink answer was received. The branch runs next."

IF @drink == "tea"
    PRINT "ORDER 6A: The tea branch ran. The coffee branches must not appear."
ELSE
    IF @drink == "coffee"
        PRINT "ORDER 6B: The coffee branch ran. The tea branch must not appear."
    ELSE
        PRINT "ORDER 6C: The fallback branch ran because the answer was neither tea nor coffee."

PRINT "ORDER 7: The drink branch finished."

ASK "ORDER 8: Should the flow finish successfully? Type exactly: yes or no" AS finish

IF @finish == "yes"
    PRINT "ORDER 9A: Yes branch selected."
ELSE
    PRINT "ORDER 9B: No branch selected."

PRINT "ORDER 10: All questions and branches are complete."
RETURN "ORDER 11: The flow returned and must execute nothing else."
