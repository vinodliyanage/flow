{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:IF\\b.*|ELSE|REPEAT\\b.*|ASYNC\\b.*|THINK\\b.*|RULES|FINALLY):\\s*$"
  }
}
