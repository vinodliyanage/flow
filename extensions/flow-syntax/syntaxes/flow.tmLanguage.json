{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flow",
  "scopeName": "source.inux-flow",
  "patterns": [
    {
      "name": "comment.line.number-sign.flow",
      "match": "^\\s*#.*$"
    },
    {
      "begin": "^\\s*(`{3,}|~{3,})\\s*(?:js|javascript)\\s*$",
      "end": "^\\s*\\1\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.fence.flow"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.fence.flow"
        }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    {
      "match": "^\\s*(ASK)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.ask"
        }
      }
    },
    {
      "match": "^\\s*(SET)\\b(?:\\s+([a-z][a-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.flow.set"
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "match": "^\\s*(RULES)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.rules"
        }
      }
    },
    {
      "match": "^\\s*(FINALLY)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.finally"
        }
      }
    },
    {
      "match": "^\\s*(THINK)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.think"
        }
      }
    },
    {
      "match": "^\\s*(DO)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.do"
        }
      }
    },
    {
      "begin": "^( *)(PRINT)[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.print"
        }
      },
      "while": "^(?:\\1    |[ \\t]*$)",
      "contentName": "string.unquoted.block.flow"
    },
    {
      "match": "^\\s*(PRINT)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.print"
        }
      }
    },
    {
      "match": "^\\s*(SHELL)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.shell"
        }
      }
    },
    {
      "match": "^\\s*(RUN)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.run"
        }
      }
    },
    {
      "match": "^[ \\t]*(USE)\\b(?:[ \\t]+(.+?\\.flow))?[ \\t]*$",
      "captures": {
        "1": {
          "name": "keyword.control.flow.use"
        },
        "2": {
          "name": "markup.underline.link.flow"
        }
      }
    },
    {
      "match": "^\\s*(CHECK)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.check"
        }
      }
    },
    {
      "match": "^\\s*(IF)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.if"
        }
      }
    },
    {
      "match": "^\\s*(ELSE)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.else"
        }
      }
    },
    {
      "match": "^\\s*(REPEAT)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.repeat"
        }
      }
    },
    {
      "match": "^\\s*(ASYNC)\\b(?:\\s+([a-z][a-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.flow.async"
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "match": "^\\s*(WAIT)\\b(?:\\s+([a-z][a-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.flow.wait"
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "match": "^\\s*(STOP)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.stop"
        }
      }
    },
    {
      "name": "string.quoted.triple.flow",
      "begin": "\"\"\"[ \\t]*$",
      "end": "^[ \\t]*\"\"\"[ \\t]*$"
    },
    {
      "name": "string.quoted.double.flow",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.flow",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.other.command.flow",
      "begin": "`",
      "end": "`|$",
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    {
      "name": "variable.other.flow",
      "match": "(?<=\\bAS )\\b[a-z][a-z0-9_]*\\b"
    },
    {
      "name": "keyword.other.flow",
      "match": "\\b(?:AS|TIMES)\\b|\\b(?:is not|is|of|with|using)\\b"
    },
    {
      "name": "support.function.flow",
      "match": "\\b(?:JSON|trim)(?=\\s*\\()"
    },
    {
      "name": "constant.language.flow.true",
      "match": "\\bTRUE\\b"
    },
    {
      "name": "constant.language.flow.false",
      "match": "\\bFALSE\\b"
    },
    {
      "name": "constant.language.flow.null",
      "match": "\\bNULL\\b"
    },
    {
      "name": "constant.numeric.flow",
      "match": "(?<![\\w.])-?\\b\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.flow",
      "match": "==|!=|<=|>=|[=<>+\\-]"
    },
    {
      "name": "punctuation.separator.block.flow",
      "match": ":\\s*$"
    },
    {
      "include": "#placeholder"
    }
  ],
  "repository": {
    "placeholder": {
      "name": "variable.other.interpolation.flow",
      "match": "\\{[a-z][a-z0-9_]*\\}"
    }
  }
}
