{
  "scopeName": "markdown.flow",
  "injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown - markup.inline.raw.string.markdown",
  "patterns": [
    {
      "begin": "(^|\\G)([ \\t]*)(`{3,})[ \\t]*(?i:flow)[ \\t]*$",
      "end": "(^|\\G)(\\2|[ \\t]{0,3})(\\3`*)[ \\t]*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.flow",
      "patterns": [
        {
          "include": "source.flow"
        }
      ]
    },
    {
      "begin": "(^|\\G)([ \\t]*)(~{3,})[ \\t]*(?i:flow)[ \\t]*$",
      "end": "(^|\\G)(\\2|[ \\t]{0,3})(\\3~*)[ \\t]*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.flow",
      "patterns": [
        {
          "include": "source.flow"
        }
      ]
    }
  ]
}
