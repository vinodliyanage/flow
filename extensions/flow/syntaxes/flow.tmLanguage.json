{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flow",
  "scopeName": "source.flow",
  "patterns": [
    {
      "name": "comment.block.flow",
      "begin": "^ *### *$",
      "end": "^ *### *$"
    },
    {
      "name": "comment.line.number-sign.flow",
      "match": "^ *#.*$"
    },
    {
      "begin": "^( *)(context)(?: +(as) +(@[a-z][a-z0-9_]*))? *$",
      "while": "^(?:\\1 {4}|[ \\t]*$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.context"
        },
        "3": {
          "name": "keyword.other.flow"
        },
        "4": {
          "name": "variable.other.flow"
        }
      },
      "contentName": "meta.literal.block.flow"
    },
    {
      "begin": "^( *)(run)\\b(.*)$",
      "while": "^(?:\\1 {4}|[ \\t]*$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.run"
        },
        "3": {
          "patterns": [
            {
              "include": "#inline"
            }
          ]
        }
      },
      "contentName": "meta.literal.block.flow"
    },
    {
      "begin": "^( *)(do)\\b(?!.*\"\"\")(.*)$",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.do"
        },
        "3": {
          "patterns": [
            {
              "include": "#inline"
            }
          ]
        }
      },
      "patterns": [
        {
          "include": "#inline"
        }
      ],
      "end": "^(?!\\1 {4}(?! )\\S)"
    },
    {
      "begin": "^( *)(print)\\b(?!.*\"\"\")(.*)$",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.flow.print"
        },
        "3": {
          "patterns": [
            {
              "include": "#inline"
            }
          ]
        }
      },
      "patterns": [
        {
          "include": "#inline"
        }
      ],
      "end": "^(?!\\1 {4}(?! )\\S)"
    },
    {
      "match": "^ *(do)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.do"
        }
      }
    },
    {
      "match": "^ *(print)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.print"
        }
      }
    },
    {
      "match": "^ *(command) +([A-Z][A-Z0-9_]*) *$",
      "captures": {
        "1": {
          "name": "keyword.control.flow.command"
        },
        "2": {
          "name": "entity.name.function.flow"
        }
      }
    },
    {
      "match": "^ *(flow) +([a-z][a-z0-9_]*) *$",
      "captures": {
        "1": {
          "name": "keyword.control.flow.flow"
        },
        "2": {
          "name": "entity.name.function.flow"
        }
      }
    },
    {
      "match": "^ *(set|async|await) +([a-z][a-z0-9_]*)",
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "set",
              "name": "keyword.control.flow.set"
            },
            {
              "match": "async",
              "name": "keyword.control.flow.async"
            },
            {
              "match": "await",
              "name": "keyword.control.flow.await"
            }
          ]
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "match": "^ *(use) +(.+?\\.md(?:#[^\\r\\n]+?)?) +(as) +(@[a-z][a-z0-9_]*) *$",
      "captures": {
        "1": {
          "name": "keyword.control.flow.use"
        },
        "2": {
          "name": "markup.underline.link.flow"
        },
        "3": {
          "name": "keyword.other.flow"
        },
        "4": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "match": "^ *(use) +(.+?\\.flow) *$",
      "captures": {
        "1": {
          "name": "keyword.control.flow.use"
        },
        "2": {
          "name": "markup.underline.link.flow"
        }
      }
    },
    {
      "match": "^ *(ask)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.ask"
        }
      }
    },
    {
      "match": "^ *(set)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.set"
        }
      }
    },
    {
      "match": "^ *(use)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.use"
        }
      }
    },
    {
      "match": "^ *(if)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.if"
        }
      }
    },
    {
      "match": "^ *(else)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.else"
        }
      }
    },
    {
      "match": "^ *(repeat)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.repeat"
        }
      }
    },
    {
      "match": "^ *(while)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.while"
        }
      }
    },
    {
      "match": "^ *(continue)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.continue"
        }
      }
    },
    {
      "match": "^ *(break)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.break"
        }
      }
    },
    {
      "match": "^ *(return)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.return"
        }
      }
    },
    {
      "match": "^ *(async)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.async"
        }
      }
    },
    {
      "match": "^ *(await)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.await"
        }
      }
    },
    {
      "match": "^ *(as) +(@[a-z][a-z0-9_]*) *$",
      "captures": {
        "1": {
          "name": "keyword.other.flow"
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    {
      "include": "#binding"
    },
    {
      "match": "^ *([A-Z][A-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.function.flow"
        }
      }
    },
    {
      "match": "^ *([a-z][a-z0-9_]*)(?= |$)",
      "captures": {
        "1": {
          "name": "entity.name.function.flow"
        }
      }
    },
    {
      "include": "#inline"
    }
  ],
  "repository": {
    "string": {
      "name": "string.quoted.double.flow",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.flow",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    "reference": {
      "name": "variable.other.reference.flow",
      "match": "@[a-z][a-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\b"
    },
    "binding": {
      "match": "\\b(as) +(@[a-z][a-z0-9_]*) *$",
      "captures": {
        "1": {
          "name": "keyword.other.flow"
        },
        "2": {
          "name": "variable.other.flow"
        }
      }
    },
    "value": {
      "patterns": [
        {
          "name": "constant.language.flow.true",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.flow.false",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.flow.null",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.numeric.flow",
          "match": "(?<![\\w.@])-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "keyword.operator.flow",
          "match": "\\b(?:and|or|not)\\b|==|!=|<=|>=|[=<>+\\-]"
        },
        {
          "name": "punctuation.section.flow",
          "match": "[()\\[\\]{},:]"
        }
      ]
    },
    "inline": {
      "patterns": [
        {
          "include": "#triple-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#binding"
        },
        {
          "include": "#reference"
        },
        {
          "include": "#value"
        },
        {
          "name": "keyword.other.flow",
          "match": "\\btimes\\b"
        }
      ]
    },
    "triple-string": {
      "name": "string.quoted.triple.flow",
      "begin": "\"\"\"",
      "end": "\"\"\""
    }
  }
}
