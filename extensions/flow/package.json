{
  "name": "flow",
  "displayName": "Flow",
  "description": "Highlight the Flow language specification and navigate USE references in .flow and Markdown files.",
  "version": "0.2.5",
  "publisher": "vinodliyanage",
  "author": "Vinod Liyanage",
  "icon": "images/icon.png",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "flow",
    "markdown",
    "syntax"
  ],
  "scripts": {
    "package": "vsce package --out dist/flow-$npm_package_version.vsix --no-dependencies --allow-missing-repository --skip-license",
    "postpackage": "node scripts/sync-vsix.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "2.32.0",
    "vscode-textmate": "9.2.0",
    "vscode-oniguruma": "1.7.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "flow",
        "aliases": [
          "Flow",
          "flow"
        ],
        "extensions": [
          ".flow"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flow",
        "scopeName": "source.flow",
        "path": "./syntaxes/flow.tmLanguage.json"
      },
      {
        "scopeName": "markdown.flow",
        "path": "./syntaxes/flow-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.flow": "flow"
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "name": "Flow: ASK",
            "scope": "keyword.control.flow.ask",
            "settings": {
              "foreground": "#56B6C2"
            }
          },
          {
            "name": "Flow: SET",
            "scope": "keyword.control.flow.set",
            "settings": {
              "foreground": "#E5C07B"
            }
          },
          {
            "name": "Flow: DO",
            "scope": "keyword.control.flow.do",
            "settings": {
              "foreground": "#61AFEF"
            }
          },
          {
            "name": "Flow: PRINT",
            "scope": "keyword.control.flow.print",
            "settings": {
              "foreground": "#F0D060"
            }
          },
          {
            "name": "Flow: CONTEXT",
            "scope": "keyword.control.flow.context",
            "settings": {
              "foreground": "#C099FF"
            }
          },
          {
            "name": "Flow: USE",
            "scope": "keyword.control.flow.use",
            "settings": {
              "foreground": "#7DCFFF"
            }
          },
          {
            "name": "Flow: IF",
            "scope": "keyword.control.flow.if",
            "settings": {
              "foreground": "#E06C75"
            }
          },
          {
            "name": "Flow: ELSE",
            "scope": "keyword.control.flow.else",
            "settings": {
              "foreground": "#E9967A"
            }
          },
          {
            "name": "Flow: REPEAT",
            "scope": "keyword.control.flow.repeat",
            "settings": {
              "foreground": "#FF79C6"
            }
          },
          {
            "name": "Flow: WHILE",
            "scope": "keyword.control.flow.while",
            "settings": {
              "foreground": "#F78C6C"
            }
          },
          {
            "name": "Flow: CONTINUE",
            "scope": "keyword.control.flow.continue",
            "settings": {
              "foreground": "#98C379"
            }
          },
          {
            "name": "Flow: BREAK",
            "scope": "keyword.control.flow.break",
            "settings": {
              "foreground": "#FF6B6B"
            }
          },
          {
            "name": "Flow: RETURN",
            "scope": "keyword.control.flow.return",
            "settings": {
              "foreground": "#FF5370"
            }
          },
          {
            "name": "Flow: RUN",
            "scope": "keyword.control.flow.run",
            "settings": {
              "foreground": "#C678DD"
            }
          },
          {
            "name": "Flow: ASYNC",
            "scope": "keyword.control.flow.async",
            "settings": {
              "foreground": "#7E9CD8"
            }
          },
          {
            "name": "Flow: AWAIT",
            "scope": "keyword.control.flow.await",
            "settings": {
              "foreground": "#73DACA"
            }
          },
          {
            "name": "Flow: declared labels",
            "scope": "variable.other.flow",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "name": "Flow: label references",
            "scope": "variable.other.reference.flow",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "name": "Flow: custom command names",
            "scope": "entity.name.function.flow",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "name": "Flow: referenced file",
            "scope": "markup.underline.link.flow",
            "settings": {
              "foreground": "#61AFEF",
              "fontStyle": "underline"
            }
          },
          {
            "name": "Flow: TRUE",
            "scope": "constant.language.flow.true",
            "settings": {
              "foreground": "#A8E6A1"
            }
          },
          {
            "name": "Flow: FALSE",
            "scope": "constant.language.flow.false",
            "settings": {
              "foreground": "#FF8F9C"
            }
          },
          {
            "name": "Flow: NULL",
            "scope": "constant.language.flow.null",
            "settings": {
              "foreground": "#FFD580"
            }
          }
        ]
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flow",
    "onLanguage:markdown"
  ],
  "extensionKind": [
    "workspace"
  ]
}
